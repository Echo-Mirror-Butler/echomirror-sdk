{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "composite": false,
    "resolveJsonModule": true,
    "types": ["vitest", "chrome"]
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules"]
}
