    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.301",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
