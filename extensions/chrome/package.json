{
  "name": "@echomirror/chrome-extension",
  "private": true,
  "version": "0.1.0",
  "description": "EchoMirror SDK Chrome extension — Stellar transaction monitor, mood widget injector, and SDK integration preview",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-manifest.mjs",
    "smoke": "node scripts/smoke-load.mjs",
    "icons": "for s in 16 32 48 128; do rsvg-convert -w $s -h $s icons/icon.svg -o icons/icon$s.png; done"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.301",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.0",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Echo-Mirror-Butler/echomirror-sdk"
  },
  "license": "MIT"
}
