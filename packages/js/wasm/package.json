{
  "name": "@echomirror/wasm",
  "version": "0.1.0",
  "description": "EchoMirror SDK compiled to WebAssembly — crypto, XDR and sync helpers for browser and Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#wasm-binding": {
      "types": "./src/wasm-binding.d.ts",
      "node": "./wasm-node/echomirror_wasm.cjs",
      "browser": "./wasm-web/echomirror_wasm.js",
      "default": "./wasm-web/echomirror_wasm.js"
    },
    "#wasm-binding-simd": {
      "types": "./src/wasm-binding.d.ts",
      "node": "./wasm-node-simd/echomirror_wasm.cjs",
      "browser": "./wasm-web-simd/echomirror_wasm.js",
      "default": "./wasm-web-simd/echomirror_wasm.js"
    }
  },
  "files": [
    "dist",
    "wasm-web",
    "wasm-node",
    "wasm-web-simd",
    "wasm-node-simd",
    "src/wasm-binding.d.ts"
  ],
  "scripts": {
    "build:wasm": "node scripts/build.mjs",
    "build": "tsc",
    "size": "node scripts/report-size.mjs",
    "size-limit": "size-limit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist wasm-web wasm-node wasm-web-simd wasm-node-simd"
  },
  "keywords": ["echomirror", "wasm", "webassembly", "stellar", "mood", "simd"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@vitest/browser": "^4.1.11",
    "playwright": "^1.44.0",
    "wasm-pack": "^0.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "Chrome >= 91",
    "Edge >= 91",
    "Firefox >= 89",
    "Safari >= 16.4",
    "not dead"
  ],
  "size-limit": [
    {
      "name": "@echomirror/wasm (scalar — always shipped)",
      "path": "wasm-web/echomirror_wasm_bg.wasm",
      "limit": "250 KB"
    },
    {
      "name": "@echomirror/wasm (SIMD build — additive, loaded only when supported)",
      "path": "wasm-web-simd/echomirror_wasm_bg.wasm",
      "limit": "260 KB"
    }
  ]
}
