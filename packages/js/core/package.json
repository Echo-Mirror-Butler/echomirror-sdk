{
  "name": "@echomirror/core",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "EchoMirror SDK core — API client, auth, and shared TypeScript types",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "wellness",
    "sdk",
    "stellar",
    "mood"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*"
  },
  "size-limit": [
    {
      "name": "@echomirror/core",
      "path": "dist/index.js",
      "limit": "2.2 KB"
    }
  ]
}
