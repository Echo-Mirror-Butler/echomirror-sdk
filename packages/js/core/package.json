{
  "name": "@echomirror/mood",
  "version": "0.1.0",
  "description": "EchoMirror SDK mood tracking module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "mood",
    "wellness"
  ],
  "license": "MIT",
  "dependencies": {
    "@echomirror/core": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  },
  "size-limit": [
    {
      "name": "@echomirror/mood",
      "path": "dist/index.js",
      "limit": "350 B"
    }
  ]
}
