{
  "name": "@echomirror/core",
  "version": "0.1.0",
  "description": "EchoMirror SDK core — API client, auth, and shared TypeScript types",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "wellness",
    "sdk",
    "stellar",
    "mood"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*"
  },
  "size-limit": [
    {
      "name": "@echomirror/core",
      "path": "dist/index.js",
      "limit": "850 B"
    }
  ]
}
