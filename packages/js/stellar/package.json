{
  "name": "@echomirror/stellar",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "EchoMirror SDK Stellar integration — multi-wallet (Freighter, Albedo, xBull), transaction builders, and typed errors",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echo-Mirror-Butler/echomirror-sdk.git",
    "directory": "packages/js/stellar"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integration": "STELLAR_INTEGRATION=1 vitest run tests/integration --testTimeout 120000",
    "pretest:e2e": "node e2e/scripts/fetch-freighter.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "stellar",
    "blockchain",
    "freighter",
    "albedo",
    "xbull",
    "wallet",
    "payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@albedo-link/intent": "^0.12.0",
    "@echomirror/core": "^0.1.0",
    "@ledgerhq/hw-app-str": "^7.7.7",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*"
  },
  "size-limit": [
    {
      "name": "@echomirror/stellar",
      "path": "dist/index.js",
      "limit": "220 KB"
    }
  ]
}
