{
  "name": "@echomirror/react",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "EchoMirror SDK React bindings",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "react",
    "wellness"
  ],
  "license": "MIT",
  "dependencies": {
    "@echomirror/core": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.0.0",
    "@vitest/coverage-v8": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "size-limit": [
    {
      "name": "@echomirror/react",
      "path": "dist/index.js",
      "limit": "2.8 KB"
    }
  ]
}
