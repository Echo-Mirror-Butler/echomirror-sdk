{
  "name": "@echomirror/social",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "EchoMirror SDK social module — global feed, leaderboard, and real-time updates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echo-Mirror-Butler/echomirror-sdk.git",
    "directory": "packages/js/social"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size-limit": "size-limit"
  },
  "keywords": [
    "echomirror",
    "social",
    "feed",
    "leaderboard",
    "wellness"
  ],
  "license": "MIT",
  "dependencies": {
    "@echomirror/core": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@vitest/coverage-v8": "*",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "size-limit": [
    {
      "name": "@echomirror/social",
      "path": "dist/index.js",
      "limit": "2.5 KB"
    }
  ]
}
