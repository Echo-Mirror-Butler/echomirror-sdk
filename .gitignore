# Node
node_modules/
package-lock.json
npm-debug.log*
*.tsbuildinfo

# Rust
/target/
Cargo.lock

# Python (crates/echomirror-python), created by scripts/bootstrap.sh
crates/echomirror-python/.venv/
crates/echomirror-python/**/__pycache__/
crates/echomirror-python/**/*.so
crates/echomirror-python/.pytest_cache/

# JS/TS build output
dist/
packages/js/*/dist/
packages/js/*/src/*.js
packages/js/*/src/*.d.ts
!packages/js/*/src/*.test.js

# vitest --coverage output
packages/js/*/coverage/

# wasm-pack build output (packages/js/wasm), via `npm run build:wasm`
packages/js/wasm/wasm-web/
packages/js/wasm/wasm-node/
packages/js/wasm/wasm-web-simd/
packages/js/wasm/wasm-node-simd/

# Flutter/Dart
packages/flutter/.dart_tool/
packages/flutter/.flutter-plugins-dependencies
packages/flutter/coverage/
packages/flutter/doc/

# Docs site - generated content (regenerated by CI/build, not authored)
docs-site/node_modules/
docs-site/build/
docs-site/.docusaurus/
docs-site/docs/api/js/
docs-site/static/api/rust/
docs-site/static/api/dart/
# Flutter
packages/flutter/.dart_tool/
packages/flutter/build/
packages/flutter/.flutter-plugins
packages/flutter/.flutter-plugins-dependencies
packages/flutter/packages

# Stellar package e2e (Freighter extension + bundled harness + reports)
packages/js/stellar/e2e/.freighter/
packages/js/stellar/e2e/app/bundle.js
packages/js/stellar/test-results/
packages/js/stellar/playwright-report/

# VS Code extension build output
extensions/vscode/out/
contract-tests/runners/**/__pycache__/

extensions/chrome/coverage/
